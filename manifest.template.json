{
  "manifest_version": 3,
  "name": "简幕：AI 视频速览与学习助手",
  "version": "0.0.0-构建时写入",
  "description": "几分钟判断一个 B 站或 YouTube 长视频值不值得看、重点看哪段；决定看了，再陪你精读。",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/TIAN-TOM/jianmu",
  "key": "",
  "permissions": ["sidePanel", "storage", "scripting", "contextMenus"],
  "host_permissions": ["https://www.bilibili.com/*", "https://api.bilibili.com/*", "https://*.hdslb.com/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "打开简幕",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "pages/sidepanel.html"
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/*",
        "https://www.bilibili.com/*/video/*",
        "https://www.bilibili.com/*/list/*"
      ],
      "js": ["content/bilibili.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pages/card.html"],
      "matches": ["https://www.bilibili.com/*"],
      "use_dynamic_url": true
    }
  ]
}
